+//! Paths in the browser: the in-memory filesystem's (sys/fs/web.rs), rooted at `/`, with a
+//! working directory every thread shares.
+
+use crate::ffi::{OsStr, OsString};
+use crate::path::{Path, PathBuf};
+use crate::sync::Mutex;
+use crate::{fmt, io};
+
+static CWD: Mutex<Option<PathBuf>> = Mutex::new(None);
+
+pub fn getcwd() -> io::Result<PathBuf> {
+    Ok(CWD.lock().unwrap_or_else(|e| e.into_inner()).clone().unwrap_or_else(|| PathBuf::from("/")))
+}
+
+pub fn chdir(path: &Path) -> io::Result<()> {
+    let absolute = crate::sys::fs::absolute_web(path)?;
+    if !crate::sys::fs::metadata(&absolute)?.file_type().is_dir() {
+        return Err(io::const_error!(io::ErrorKind::NotADirectory, "not a directory"));
+    }
+    *CWD.lock().unwrap_or_else(|e| e.into_inner()) = Some(absolute);
+    Ok(())
+}
+
+pub struct SplitPaths<'a> {
+    iter: crate::str::Split<'a, char>,
+}
+
+pub fn split_paths(unparsed: &OsStr) -> SplitPaths<'_> {
+    SplitPaths { iter: unparsed.to_str().unwrap_or("").split(':') }
+}
+
+pub struct SplitPathsRef<'a> {
+    iter: crate::str::Split<'a, char>,
+}
+
+pub fn split_paths_ref(unparsed: &OsStr) -> Option<SplitPathsRef<'_>> {
+    Some(SplitPathsRef { iter: unparsed.to_str()?.split(':') })
+}
+
+impl<'a> Iterator for SplitPaths<'a> {
+    type Item = PathBuf;
+    fn next(&mut self) -> Option<PathBuf> {
+        self.iter.next().map(PathBuf::from)
+    }
+}
+
+impl<'a> Iterator for SplitPathsRef<'a> {
+    type Item = &'a Path;
+    fn next(&mut self) -> Option<&'a Path> {
+        self.iter.next().map(Path::new)
+    }
+}
+
+#[derive(Debug)]
+pub struct JoinPathsError;
+
+pub fn join_paths<I, T>(paths: I) -> Result<OsString, JoinPathsError>
+where
+    I: Iterator<Item = T>,
+    T: AsRef<OsStr>,
+{
+    let mut joined = OsString::new();
+    for (i, path) in paths.enumerate() {
+        let path = path.as_ref();
+        if path.to_str().map_or(true, |p| p.contains(':')) {
+            return Err(JoinPathsError);
+        }
+        if i > 0 {
+            joined.push(":");
+        }
+        joined.push(path);
+    }
+    Ok(joined)
+}
+
+impl fmt::Display for JoinPathsError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        "path contains a `:`".fmt(f)
+    }
+}
+
+impl crate::error::Error for JoinPathsError {}
+
+pub fn current_exe() -> io::Result<PathBuf> {
+    Ok(PathBuf::from("/horizon/horizon-client"))
+}
+
+pub fn temp_dir() -> PathBuf {
+    PathBuf::from("/tmp")
+}
+
+pub fn home_dir() -> Option<PathBuf> {
+    Some(PathBuf::from("/home"))
+}
