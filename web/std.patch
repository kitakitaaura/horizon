+//! The program's arguments in the browser: what the page set before starting it
+//! (`__horizon_web_args_push`), after the program's own name.
+
+pub use super::common::Args;
+use crate::ffi::OsString;
+use crate::sync::Mutex;
+
+static ARGS: Mutex<Vec<OsString>> = Mutex::new(Vec::new());
+
+pub fn args() -> Args {
+    let mut all = vec![OsString::from("horizon")];
+    all.extend(ARGS.lock().unwrap_or_else(|e| e.into_inner()).iter().cloned());
+    Args::new(all)
+}
+
+/// Appends one argument (UTF-8 bytes) for the next `std::env::args()`.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn __horizon_web_args_push(ptr: *const u8, len: usize) {
+    // SAFETY: the caller passes `len` readable bytes.
+    let bytes = unsafe { crate::slice::from_raw_parts(ptr, len) };
+    let arg = OsString::from(crate::string::String::from_utf8_lossy(bytes).into_owned());
+    ARGS.lock().unwrap_or_else(|e| e.into_inner()).push(arg);
+}
