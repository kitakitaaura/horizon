+//! Threads in the browser: each runs on a Web Worker from the page's pool (`sys::web_host`).
+
+use crate::ffi::CStr;
+use crate::io;
+use crate::num::NonZero;
+use crate::sync::Arc;
+use crate::sync::atomic::{AtomicU32, Ordering};
+use crate::sys::sync::futex::{futex_wait, futex_wake_all};
+use crate::sys::web_host;
+use crate::thread::ThreadInit;
+use crate::time::Duration;
+
+pub const DEFAULT_MIN_STACK_SIZE: usize = 2 * 1024 * 1024;
+
+pub struct Thread {
+    /// 1 once the thread's entry and its thread-local destructors have run.
+    done: Arc<AtomicU32>,
+}
+
+impl Thread {
+    // unsafe: see thread::Builder::spawn_unchecked for safety requirements
+    pub unsafe fn new(_stack: usize, init: Box<ThreadInit>) -> io::Result<Thread> {
+        // The stack is the worker's own, sized by the page when it started the worker.
+        let done = Arc::new(AtomicU32::new(0));
+        let finished = done.clone();
+        web_host::post(web_host::Job {
+            run: Box::new(move || {
+                let main = init.init();
+                main();
+                // SAFETY: the thread's code has returned; nothing borrows its thread-locals.
+                unsafe { crate::sys::thread_local::destructors::run() };
+                crate::rt::thread_cleanup();
+                finished.store(1, Ordering::Release);
+                futex_wake_all(&finished);
+            }),
+        });
+        Ok(Thread { done })
+    }
+
+    pub fn join(self) {
+        while self.done.load(Ordering::Acquire) == 0 {
+            futex_wait(&self.done, 0, None);
+        }
+    }
+}
+
+pub fn available_parallelism() -> io::Result<NonZero<usize>> {
+    NonZero::new(web_host::hardware_concurrency() as usize).ok_or(io::Error::UNKNOWN_THREAD_COUNT)
+}
+
+pub fn current_os_id() -> Option<u64> {
+    None
+}
+
+pub fn yield_now() {
+    crate::hint::spin_loop();
+}
+
+pub fn set_name(_name: &CStr) {}
+
+pub fn sleep(dur: Duration) {
+    if web_host::can_block() {
+        super::wasm::sleep(dur)
+    } else {
+        web_host::spin_sleep(dur)
+    }
+}
