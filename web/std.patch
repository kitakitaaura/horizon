+//! Environment variables in the browser: a map in memory, shared by every thread, that the page
+//! may fill before the program starts.
+
+use crate::collections::BTreeMap;
+use crate::ffi::{OsStr, OsString};
+use crate::sync::Mutex;
+use crate::{fmt, io, vec};
+
+static VARS: Mutex<BTreeMap<OsString, OsString>> = Mutex::new(BTreeMap::new());
+
+fn vars() -> crate::sync::MutexGuard<'static, BTreeMap<OsString, OsString>> {
+    VARS.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+pub struct Env {
+    iter: vec::IntoIter<(OsString, OsString)>,
+}
+
+impl fmt::Debug for Env {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_list().entries(self.iter.as_slice()).finish()
+    }
+}
+
+impl Iterator for Env {
+    type Item = (OsString, OsString);
+    fn next(&mut self) -> Option<(OsString, OsString)> {
+        self.iter.next()
+    }
+}
+
+pub fn env() -> Env {
+    let snapshot: Vec<_> = vars().iter().map(|(k, v)| (k.clone(), v.clone())).collect();
+    Env { iter: snapshot.into_iter() }
+}
+
+pub fn getenv(key: &OsStr) -> Option<OsString> {
+    vars().get(key).cloned()
+}
+
+pub unsafe fn setenv(key: &OsStr, value: &OsStr) -> io::Result<()> {
+    vars().insert(key.to_owned(), value.to_owned());
+    Ok(())
+}
+
+pub unsafe fn unsetenv(key: &OsStr) -> io::Result<()> {
+    vars().remove(key);
+    Ok(())
+}
