+//! Horizon's browser platform for `wasm32-unknown-unknown` with `+atomics`.
+//!
+//! The browser gives a wasm module no clock, filesystem or thread of its own. This module is the
+//! piece of std that the rest of the patched `sys` modules (`time/web.rs`, `thread/web.rs`,
+//! `fs/web.rs`, `env/web.rs`, `paths/web.rs`) share:
+//!
+//! * the host hooks: `extern "C"` functions the program itself defines (Horizon's web crate,
+//!   with js-sys), resolved when the final module links. std stays free of JS glue.
+//! * whether the running thread is the page's main thread, which may not block
+//!   (`memory.atomic.wait32` traps there): waits spin on it instead, as Emscripten does.
+//! * the thread pool. A Web Worker starts only once the thread that created it returns to the
+//!   browser's event loop, so a thread that spawns another and then waits for it would wait
+//!   forever. Idle workers wait ready ahead of time (each calls [`__horizon_web_worker_main`]); a
+//!   spawn hands its thread to one of them at once. The page's spawner, a worker that runs no
+//!   wasm and so is never blocked, starts more as [`WANTED`] asks, waiting on it with
+//!   `Atomics.waitAsync` (its address: [`__horizon_web_pool_wanted_addr`]). Each thread runs on a
+//!   fresh instance of the module, so it gets fresh thread-locals and its own stack; the worker
+//!   then sets up a new instance for the next one (web/worker.js).
+
+use crate::boxed::Box;
+use crate::cell::Cell;
+use crate::collections::VecDeque;
+use crate::sync::Mutex;
+use crate::sync::atomic::{Atomic, AtomicU32, Ordering};
+use crate::sys::sync::futex::{futex_wait, futex_wake, futex_wake_all};
+use crate::time::Duration;
+
+unsafe extern "C" {
+    /// Milliseconds on a clock that never goes back and is the same on every thread
+    /// (`performance.timeOrigin + performance.now()`).
+    fn __horizon_web_monotonic_ms() -> f64;
+    /// Milliseconds since the Unix epoch (`Date.now()`).
+    fn __horizon_web_wall_ms() -> f64;
+    /// `navigator.hardwareConcurrency`.
+    fn __horizon_web_hardware_concurrency() -> u32;
+    /// Fills `len` bytes at `ptr` from `crypto.getRandomValues`.
+    fn __horizon_web_random_fill(ptr: *mut u8, len: usize);
+    /// Bytes for the console (stdout and stderr), which the host buffers into lines.
+    fn __horizon_web_write_console(ptr: *const u8, len: usize);
+}
+
+pub fn random_fill(bytes: &mut [u8]) {
+    unsafe { __horizon_web_random_fill(bytes.as_mut_ptr(), bytes.len()) }
+}
+
+pub fn write_console(bytes: &[u8]) {
+    unsafe { __horizon_web_write_console(bytes.as_ptr(), bytes.len()) }
+}
+
+pub fn monotonic() -> Duration {
+    Duration::from_secs_f64(unsafe { __horizon_web_monotonic_ms() }.max(0.0) / 1000.0)
+}
+
+pub fn wall() -> Duration {
+    Duration::from_secs_f64(unsafe { __horizon_web_wall_ms() }.max(0.0) / 1000.0)
+}
+
+pub fn hardware_concurrency() -> u32 {
+    unsafe { __horizon_web_hardware_concurrency() }
+}
+
+#[thread_local]
+static IS_WORKER: Cell<bool> = Cell::new(false);
+
+/// Whether this thread may block: every thread but the page's main one.
+#[inline]
+pub fn can_block() -> bool {
+    IS_WORKER.get()
+}
+
+/// Waits while `futex` holds `expected`, by spinning: for the main thread, which can't block.
+/// False when `timeout` passed first.
+pub fn spin_wait(futex: &Atomic<u32>, expected: u32, timeout: Option<Duration>) -> bool {
+    let deadline = timeout.map(|t| monotonic() + t);
+    let mut spins = 0u32;
+    while futex.load(Ordering::Acquire) == expected {
+        spins = spins.wrapping_add(1);
+        // The clock is a call out to JS: look at it only now and then.
+        if spins % 1024 == 0
+            && let Some(deadline) = deadline
+            && monotonic() >= deadline
+        {
+            return false;
+        }
+        crate::hint::spin_loop();
+    }
+    true
+}
+
+/// Sleeps by spinning on the clock: for the main thread, which can't block.
+pub fn spin_sleep(dur: Duration) {
+    let until = monotonic() + dur;
+    while monotonic() < until {
+        crate::hint::spin_loop();
+    }
+}
+
+/// A thread to start, handed to an idle worker.
+pub struct Job {
+    pub run: Box<dyn FnOnce()>,
+}
+
+// SAFETY: the job's closure is the Rust thread's entry, which std::thread built from `Send` parts.
+unsafe impl Send for Job {}
+
+struct Pool {
+    jobs: VecDeque<Job>,
+}
+
+static POOL: Mutex<Pool> = Mutex::new(Pool { jobs: VecDeque::new() });
+/// Bumped on every push; idle workers wait on it.
+static POSTED: AtomicU32 = AtomicU32::new(0);
+/// Workers waiting for a job.
+static IDLE: AtomicU32 = AtomicU32::new(0);
+/// Idle workers the page should keep ready beyond the jobs waiting.
+static MIN_IDLE: AtomicU32 = AtomicU32::new(8);
+/// Threads posted that no worker has taken yet.
+static QUEUED: AtomicU32 = AtomicU32::new(0);
+/// How many more workers the pool needs: enough for every waiting thread plus the idle reserve.
+/// The spawner waits on it (`Atomics.waitAsync`) and subtracts the workers it started that
+/// haven't reached [`__horizon_web_worker_main`] yet.
+static WANTED: AtomicU32 = AtomicU32::new(0);
+
+fn update_wanted() {
+    let want = (MIN_IDLE.load(Ordering::Relaxed) + QUEUED.load(Ordering::Acquire))
+        .saturating_sub(IDLE.load(Ordering::Acquire));
+    if WANTED.swap(want, Ordering::AcqRel) != want {
+        futex_wake_all(&WANTED);
+    }
+}
+
+/// Queues a thread for the next idle worker.
+pub fn post(job: Job) {
+    POOL.lock().unwrap_or_else(|e| e.into_inner()).jobs.push_back(job);
+    QUEUED.fetch_add(1, Ordering::AcqRel);
+    POSTED.fetch_add(1, Ordering::Release);
+    futex_wake(&POSTED);
+    update_wanted();
+}
+
+/// How many more workers the pool needs now (see [`WANTED`]).
+#[unsafe(no_mangle)]
+pub extern "C" fn __horizon_web_pool_wanted() -> u32 {
+    WANTED.load(Ordering::Acquire)
+}
+
+/// Where [`WANTED`] is in memory, for the spawner's `Atomics.waitAsync`.
+#[unsafe(no_mangle)]
+pub extern "C" fn __horizon_web_pool_wanted_addr() -> usize {
+    WANTED.as_ptr() as usize
+}
+
+/// Sets how many idle workers the page keeps ready.
+#[unsafe(no_mangle)]
+pub extern "C" fn __horizon_web_pool_set_reserve(count: u32) {
+    MIN_IDLE.store(count, Ordering::Relaxed);
+    update_wanted();
+}
+
+/// Workers waiting for a thread to run.
+#[unsafe(no_mangle)]
+pub extern "C" fn __horizon_web_pool_idle() -> u32 {
+    IDLE.load(Ordering::Acquire)
+}
+
+/// A Web Worker's entry once wasm-bindgen has set it up: waits for one thread, runs it with its
+/// thread-local destructors, and returns. The page then frees the instance's stack and
+/// thread-locals (`__wbindgen_thread_destroy`) and sets up a new one on the same worker.
+#[unsafe(no_mangle)]
+pub extern "C" fn __horizon_web_worker_main() {
+    IS_WORKER.set(true);
+    IDLE.fetch_add(1, Ordering::AcqRel);
+    update_wanted();
+    let job = loop {
+        let seen = POSTED.load(Ordering::Acquire);
+        if let Some(job) = POOL.lock().unwrap_or_else(|e| e.into_inner()).jobs.pop_front() {
+            break job;
+        }
+        futex_wait(&POSTED, seen, None);
+    };
+    QUEUED.fetch_sub(1, Ordering::AcqRel);
+    IDLE.fetch_sub(1, Ordering::AcqRel);
+    update_wanted();
+    // Another idle worker may have been woken for a job this one took: let it look again.
+    if !POOL.lock().unwrap_or_else(|e| e.into_inner()).jobs.is_empty() {
+        futex_wake_all(&POSTED);
+    }
+    (job.run)();
+}
