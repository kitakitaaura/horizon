index 0000000..f3f560f
--- /dev/null
+++ b/std/src/sys/fs/web.rs
@@ -0,0 +1,878 @@
+//! The filesystem in the browser: a tree in the module's shared memory, so every thread sees the
+//! same files. The tree's shape (names, directories) is behind one lock that operations hold
+//! briefly; each file's bytes have their own lock, so an open file keeps working after it was
+//! renamed or removed, as on Unix. Nothing here survives the page: the program copies what it
+//! keeps (saves, options) to the browser's storage itself.
+//!
+//! No symbolic links. Hard links share the file's bytes.
+
+use crate::collections::BTreeMap;
+use crate::ffi::OsString;
+use crate::fmt;
+use crate::fs::TryLockError;
+use crate::hash::Hash;
+use crate::io::{self, BorrowedCursor, IoSlice, IoSliceMut, SeekFrom};
+use crate::path::{Component, Path, PathBuf};
+use crate::sync::atomic::{AtomicU64, Ordering};
+use crate::sync::{Arc, Mutex, RwLock};
+pub use crate::sys::fs::common::{Dir, ExtraHomeDirs, ExtraMediaDirs};
+use crate::sys::time::{SystemTime, UNIX_EPOCH};
+use crate::vec;
+
+macro_rules! fs_error {
+    ($kind:ident, $msg:literal) => {
+        io::const_error!(io::ErrorKind::$kind, $msg)
+    };
+}
+
+#[derive(Clone, Copy)]
+struct Times {
+    modified: SystemTime,
+    accessed: SystemTime,
+    created: SystemTime,
+}
+
+impl Times {
+    fn now() -> Times {
+        let now = SystemTime::now();
+        Times { modified: now, accessed: now, created: now }
+    }
+}
+
+struct FileNode {
+    data: RwLock<Vec<u8>>,
+    times: Mutex<Times>,
+    readonly: crate::sync::atomic::AtomicBool,
+}
+
+impl FileNode {
+    fn new(data: Vec<u8>) -> Arc<FileNode> {
+        Arc::new(FileNode {
+            data: RwLock::new(data),
+            times: Mutex::new(Times::now()),
+            readonly: crate::sync::atomic::AtomicBool::new(false),
+        })
+    }
+    fn attr(&self) -> FileAttr {
+        let size = self.data.read().unwrap_or_else(|e| e.into_inner()).len() as u64;
+        let times = *self.times.lock().unwrap_or_else(|e| e.into_inner());
+        FileAttr {
+            kind: FileType(Kind::File),
+            size,
+            times,
+            readonly: self.readonly.load(Ordering::Relaxed),
+        }
+    }
+    fn touch(&self) {
+        self.times.lock().unwrap_or_else(|e| e.into_inner()).modified = SystemTime::now();
+    }
+}
+
+struct DirNode {
+    entries: BTreeMap<OsString, Node>,
+    times: Times,
+}
+
+impl DirNode {
+    const fn empty() -> DirNode {
+        DirNode {
+            entries: BTreeMap::new(),
+            times: Times { modified: UNIX_EPOCH, accessed: UNIX_EPOCH, created: UNIX_EPOCH },
+        }
+    }
+    fn new() -> DirNode {
+        DirNode { entries: BTreeMap::new(), times: Times::now() }
+    }
+    fn attr(&self) -> FileAttr {
+        FileAttr { kind: FileType(Kind::Dir), size: 0, times: self.times, readonly: false }
+    }
+}
+
+enum Node {
+    Dir(DirNode),
+    File(Arc<FileNode>),
+}
+
+impl Node {
+    fn attr(&self) -> FileAttr {
+        match self {
+            Node::Dir(d) => d.attr(),
+            Node::File(f) => f.attr(),
+        }
+    }
+}
+
+static ROOT: RwLock<DirNode> = RwLock::new(DirNode::empty());
+
+fn read_root() -> crate::sync::RwLockReadGuard<'static, DirNode> {
+    ROOT.read().unwrap_or_else(|e| e.into_inner())
+}
+
+fn write_root() -> crate::sync::RwLockWriteGuard<'static, DirNode> {
+    ROOT.write().unwrap_or_else(|e| e.into_inner())
+}
+
+/// `path`'s names from the root: relative paths start at the working directory, `.` is
+/// dropped and `..` goes up (never above the root).
+fn names(path: &Path) -> io::Result<Vec<OsString>> {
+    let mut names = Vec::new();
+    if !path.has_root() {
+        for c in crate::sys::paths::getcwd()?.components() {
+            if let Component::Normal(name) = c {
+                names.push(name.to_owned());
+            }
+        }
+    }
+    for c in path.components() {
+        match c {
+            Component::RootDir => names.clear(),
+            Component::CurDir | Component::Prefix(_) => {}
+            Component::ParentDir => {
+                names.pop();
+            }
+            Component::Normal(name) => names.push(name.to_owned()),
+        }
+    }
+    Ok(names)
+}
+
+fn to_path(names: &[OsString]) -> PathBuf {
+    let mut path = PathBuf::from("/");
+    for name in names {
+        path.push(name);
+    }
+    path
+}
+
+/// `path` made absolute with its `.` and `..` resolved.
+pub fn absolute_web(path: &Path) -> io::Result<PathBuf> {
+    Ok(to_path(&names(path)?))
+}
+
+fn find<'a>(root: &'a DirNode, names: &[OsString]) -> io::Result<&'a Node> {
+    let (last, parents) = match names.split_last() {
+        Some(split) => split,
+        None => return Err(fs_error!(InvalidInput, "the root has no node of its own")),
+    };
+    let dir = find_dir(root, parents)?;
+    dir.entries.get(last).ok_or(fs_error!(NotFound, "no such file or directory"))
+}
+
+fn find_dir<'a>(root: &'a DirNode, names: &[OsString]) -> io::Result<&'a DirNode> {
+    let mut dir = root;
+    for name in names {
+        match dir.entries.get(name) {
+            Some(Node::Dir(d)) => dir = d,
+            Some(Node::File(_)) => return Err(fs_error!(NotADirectory, "not a directory")),
+            None => return Err(fs_error!(NotFound, "no such file or directory")),
+        }
+    }
+    Ok(dir)
+}
+
+fn find_dir_mut<'a>(root: &'a mut DirNode, names: &[OsString]) -> io::Result<&'a mut DirNode> {
+    let mut dir = root;
+    for name in names {
+        match dir.entries.get_mut(name) {
+            Some(Node::Dir(d)) => dir = d,
+            Some(Node::File(_)) => return Err(fs_error!(NotADirectory, "not a directory")),
+            None => return Err(fs_error!(NotFound, "no such file or directory")),
+        }
+    }
+    Ok(dir)
+}
+
+fn stat_names(names: &[OsString]) -> io::Result<FileAttr> {
+    let root = read_root();
+    if names.is_empty() {
+        return Ok(root.attr());
+    }
+    Ok(find(&root, names)?.attr())
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+enum Kind {
+    File,
+    Dir,
+}
+
+#[derive(Clone)]
+pub struct FileAttr {
+    kind: FileType,
+    size: u64,
+    times: Times,
+    readonly: bool,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Hash, Debug)]
+pub struct FileType(Kind);
+
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct FilePermissions {
+    readonly: bool,
+}
+
+#[derive(Copy, Clone, Debug, Default)]
+pub struct FileTimes {
+    accessed: Option<SystemTime>,
+    modified: Option<SystemTime>,
+}
+
+#[derive(Clone, Debug)]
+pub struct OpenOptions {
+    read: bool,
+    write: bool,
+    append: bool,
+    truncate: bool,
+    create: bool,
+    create_new: bool,
+}
+
+#[derive(Debug)]
+pub struct DirBuilder {}
+
+enum Handle {
+    File(Arc<FileNode>),
+    Dir(Vec<OsString>),
+}
+
+pub struct File {
+    handle: Handle,
+    /// Shared with the handle's duplicates, as an `fd`'s offset is.
+    pos: Arc<AtomicU64>,
+    read: bool,
+    write: bool,
+    append: bool,
+}
+
+pub struct ReadDir {
+    root: PathBuf,
+    entries: vec::IntoIter<DirEntry>,
+}
+
+pub struct DirEntry {
+    root: PathBuf,
+    name: OsString,
+    attr: FileAttr,
+}
+
+impl FileAttr {
+    pub fn size(&self) -> u64 {
+        self.size
+    }
+
+    pub fn perm(&self) -> FilePermissions {
+        FilePermissions { readonly: self.readonly }
+    }
+
+    pub fn file_type(&self) -> FileType {
+        self.kind
+    }
+
+    pub fn modified(&self) -> io::Result<SystemTime> {
+        Ok(self.times.modified)
+    }
+
+    pub fn accessed(&self) -> io::Result<SystemTime> {
+        Ok(self.times.accessed)
+    }
+
+    pub fn created(&self) -> io::Result<SystemTime> {
+        Ok(self.times.created)
+    }
+}
+
+impl FilePermissions {
+    pub fn readonly(&self) -> bool {
+        self.readonly
+    }
+
+    pub fn set_readonly(&mut self, readonly: bool) {
+        self.readonly = readonly;
+    }
+}
+
+impl FileTimes {
+    pub fn set_accessed(&mut self, t: SystemTime) {
+        self.accessed = Some(t);
+    }
+    pub fn set_modified(&mut self, t: SystemTime) {
+        self.modified = Some(t);
+    }
+}
+
+impl FileType {
+    pub fn is_dir(&self) -> bool {
+        self.0 == Kind::Dir
+    }
+
+    pub fn is_file(&self) -> bool {
+        self.0 == Kind::File
+    }
+
+    pub fn is_symlink(&self) -> bool {
+        false
+    }
+}
+
+impl ReadDir {
+    pub fn dir(&self) -> io::Result<Dir> {
+        Dir::open_for_traversal(&self.root)
+    }
+}
+
+impl fmt::Debug for ReadDir {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_tuple("ReadDir").field(&self.root).finish()
+    }
+}
+
+impl Iterator for ReadDir {
+    type Item = io::Result<DirEntry>;
+
+    fn next(&mut self) -> Option<io::Result<DirEntry>> {
+        self.entries.next().map(Ok)
+    }
+}
+
+impl DirEntry {
+    pub fn path(&self) -> PathBuf {
+        self.root.join(&self.name)
+    }
+
+    pub fn file_name(&self) -> OsString {
+        self.name.clone()
+    }
+
+    pub fn metadata(&self) -> io::Result<FileAttr> {
+        Ok(self.attr.clone())
+    }
+
+    pub fn file_type(&self) -> io::Result<FileType> {
+        Ok(self.attr.kind)
+    }
+}
+
+impl OpenOptions {
+    pub fn new() -> OpenOptions {
+        OpenOptions {
+            read: false,
+            write: false,
+            append: false,
+            truncate: false,
+            create: false,
+            create_new: false,
+        }
+    }
+
+    pub fn read(&mut self, read: bool) {
+        self.read = read;
+    }
+    pub fn write(&mut self, write: bool) {
+        self.write = write;
+    }
+    pub fn append(&mut self, append: bool) {
+        self.append = append;
+    }
+    pub fn truncate(&mut self, truncate: bool) {
+        self.truncate = truncate;
+    }
+    pub fn create(&mut self, create: bool) {
+        self.create = create;
+    }
+    pub fn create_new(&mut self, create_new: bool) {
+        self.create_new = create_new;
+    }
+}
+
+impl File {
+    pub fn open(path: &Path, opts: &OpenOptions) -> io::Result<File> {
+        let names = names(path)?;
+        let writes = opts.write || opts.append;
+        let creates = opts.create || opts.create_new;
+        if creates && !writes {
+            return Err(fs_error!(InvalidInput, "creating a file needs write or append"));
+        }
+        let handle = if names.is_empty() {
+            if writes {
+                return Err(fs_error!(IsADirectory, "is a directory"));
+            }
+            Handle::Dir(names)
+        } else {
+            let (last, parents) = names.split_last().unwrap();
+            let existing = {
+                let root = read_root();
+                match find_dir(&root, parents)?.entries.get(last) {
+                    Some(Node::File(f)) => Some(Handle::File(f.clone())),
+                    Some(Node::Dir(_)) => Some(Handle::Dir(names.clone())),
+                    None => None,
+                }
+            };
+            match existing {
+                Some(_) if opts.create_new => {
+                    return Err(fs_error!(AlreadyExists, "file exists"));
+                }
+                Some(Handle::Dir(_)) if writes => {
+                    return Err(fs_error!(IsADirectory, "is a directory"));
+                }
+                Some(handle) => handle,
+                None if creates => {
+                    let mut root = write_root();
+                    let dir = find_dir_mut(&mut root, parents)?;
+                    // Another thread may have made it since the read lock was let go.
+                    match dir.entries.get(last) {
+                        Some(Node::File(f)) if !opts.create_new => Handle::File(f.clone()),
+                        Some(Node::File(_)) => {
+                            return Err(fs_error!(AlreadyExists, "file exists"));
+                        }
+                        Some(Node::Dir(_)) => {
+                            return Err(fs_error!(IsADirectory, "is a directory"));
+                        }
+                        None => {
+                            let node = FileNode::new(Vec::new());
+                            dir.entries.insert(last.clone(), Node::File(node.clone()));
+                            dir.times.modified = SystemTime::now();
+                            Handle::File(node)
+                        }
+                    }
+                }
+                None => return Err(fs_error!(NotFound, "no such file or directory")),
+            }
+        };
+        if let Handle::File(node) = &handle {
+            if writes && node.readonly.load(Ordering::Relaxed) {
+                return Err(fs_error!(PermissionDenied, "read-only file"));
+            }
+            if opts.truncate && writes {
+                node.data.write().unwrap_or_else(|e| e.into_inner()).clear();
+                node.touch();
+            }
+        }
+        Ok(File {
+            handle,
+            pos: Arc::new(AtomicU64::new(0)),
+            read: opts.read || !writes,
+            write: writes,
+            append: opts.append,
+        })
+    }
+
+    fn node(&self) -> io::Result<&Arc<FileNode>> {
+        match &self.handle {
+            Handle::File(node) => Ok(node),
+            Handle::Dir(_) => Err(fs_error!(IsADirectory, "is a directory")),
+        }
+    }
+
+    pub fn file_attr(&self) -> io::Result<FileAttr> {
+        match &self.handle {
+            Handle::File(node) => Ok(node.attr()),
+            Handle::Dir(names) => stat_names(names),
+        }
+    }
+
+    pub fn fsync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn datasync(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn lock(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn lock_shared(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn try_lock(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+
+    pub fn try_lock_shared(&self) -> Result<(), TryLockError> {
+        Ok(())
+    }
+
+    pub fn unlock(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn truncate(&self, size: u64) -> io::Result<()> {
+        if !self.write {
+            return Err(fs_error!(InvalidInput, "file not opened for writing"));
+        }
+        let node = self.node()?;
+        let size = usize::try_from(size).map_err(|_| fs_error!(FileTooLarge, "file too large"))?;
+        node.data.write().unwrap_or_else(|e| e.into_inner()).resize(size, 0);
+        node.touch();
+        Ok(())
+    }
+
+    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        if !self.read {
+            return Err(fs_error!(InvalidInput, "file not opened for reading"));
+        }
+        let data = self.node()?.data.read().unwrap_or_else(|e| e.into_inner());
+        let pos = self.pos.load(Ordering::Acquire);
+        let start = (pos as usize).min(data.len());
+        let n = buf.len().min(data.len() - start);
+        buf[..n].copy_from_slice(&data[start..start + n]);
+        self.pos.store(pos + n as u64, Ordering::Release);
+        Ok(n)
+    }
+
+    pub fn read_vectored(&self, bufs: &mut [IoSliceMut<'_>]) -> io::Result<usize> {
+        crate::io::default_read_vectored(|b| self.read(b), bufs)
+    }
+
+    pub fn is_read_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn read_buf(&self, mut cursor: BorrowedCursor<'_, u8>) -> io::Result<()> {
+        if !self.read {
+            return Err(fs_error!(InvalidInput, "file not opened for reading"));
+        }
+        let data = self.node()?.data.read().unwrap_or_else(|e| e.into_inner());
+        let pos = self.pos.load(Ordering::Acquire);
+        let start = (pos as usize).min(data.len());
+        let n = cursor.capacity().min(data.len() - start);
+        cursor.append(&data[start..start + n]);
+        self.pos.store(pos + n as u64, Ordering::Release);
+        Ok(())
+    }
+
+    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
+        if !self.write {
+            return Err(fs_error!(InvalidInput, "file not opened for writing"));
+        }
+        let node = self.node()?;
+        let mut data = node.data.write().unwrap_or_else(|e| e.into_inner());
+        let pos = if self.append { data.len() } else { self.pos.load(Ordering::Acquire) as usize };
+        let end = pos + buf.len();
+        if data.len() < end {
+            data.resize(end, 0);
+        }
+        data[pos..end].copy_from_slice(buf);
+        self.pos.store(end as u64, Ordering::Release);
+        drop(data);
+        node.touch();
+        Ok(buf.len())
+    }
+
+    pub fn write_vectored(&self, bufs: &[IoSlice<'_>]) -> io::Result<usize> {
+        crate::io::default_write_vectored(|b| self.write(b), bufs)
+    }
+
+    pub fn is_write_vectored(&self) -> bool {
+        false
+    }
+
+    pub fn flush(&self) -> io::Result<()> {
+        Ok(())
+    }
+
+    pub fn seek(&self, pos: SeekFrom) -> io::Result<u64> {
+        let len = match &self.handle {
+            Handle::File(node) => node.data.read().unwrap_or_else(|e| e.into_inner()).len() as i128,
+            Handle::Dir(_) => 0,
+        };
+        let new = match pos {
+            SeekFrom::Start(n) => n as i128,
+            SeekFrom::End(n) => len + n as i128,
+            SeekFrom::Current(n) => self.pos.load(Ordering::Acquire) as i128 + n as i128,
+        };
+        let new = u64::try_from(new)
+            .map_err(|_| fs_error!(InvalidInput, "seek to a negative or overflowing position"))?;
+        self.pos.store(new, Ordering::Release);
+        Ok(new)
+    }
+
+    pub fn size(&self) -> Option<io::Result<u64>> {
+        Some(self.file_attr().map(|a| a.size))
+    }
+
+    pub fn tell(&self) -> io::Result<u64> {
+        Ok(self.pos.load(Ordering::Acquire))
+    }
+
+    pub fn duplicate(&self) -> io::Result<File> {
+        let handle = match &self.handle {
+            Handle::File(node) => Handle::File(node.clone()),
+            Handle::Dir(names) => Handle::Dir(names.clone()),
+        };
+        Ok(File {
+            handle,
+            pos: self.pos.clone(),
+            read: self.read,
+            write: self.write,
+            append: self.append,
+        })
+    }
+
+    pub fn set_permissions(&self, perm: FilePermissions) -> io::Result<()> {
+        if let Handle::File(node) = &self.handle {
+            node.readonly.store(perm.readonly, Ordering::Relaxed);
+        }
+        Ok(())
+    }
+
+    pub fn set_times(&self, times: FileTimes) -> io::Result<()> {
+        if let Handle::File(node) = &self.handle {
+            let mut t = node.times.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(a) = times.accessed {
+                t.accessed = a;
+            }
+            if let Some(m) = times.modified {
+                t.modified = m;
+            }
+        }
+        Ok(())
+    }
+}
+
+impl DirBuilder {
+    pub fn new() -> DirBuilder {
+        DirBuilder {}
+    }
+
+    pub fn mkdir(&self, p: &Path) -> io::Result<()> {
+        let names = names(p)?;
+        let Some((last, parents)) = names.split_last() else {
+            return Err(fs_error!(AlreadyExists, "the root exists"));
+        };
+        let mut root = write_root();
+        let dir = find_dir_mut(&mut root, parents)?;
+        if dir.entries.contains_key(last) {
+            return Err(fs_error!(AlreadyExists, "file exists"));
+        }
+        dir.entries.insert(last.clone(), Node::Dir(DirNode::new()));
+        dir.times.modified = SystemTime::now();
+        Ok(())
+    }
+}
+
+impl fmt::Debug for File {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let kind = match self.handle {
+            Handle::File(_) => "file",
+            Handle::Dir(_) => "dir",
+        };
+        f.debug_struct("File").field("kind", &kind).field("pos", &self.pos).finish()
+    }
+}
+
+pub fn readdir(p: &Path) -> io::Result<ReadDir> {
+    let names = names(p)?;
+    let root = read_root();
+    let dir = find_dir(&root, &names)?;
+    let entries: Vec<DirEntry> = dir
+        .entries
+        .iter()
+        .map(|(name, node)| DirEntry { root: p.to_owned(), name: name.clone(), attr: node.attr() })
+        .collect();
+    Ok(ReadDir { root: p.to_owned(), entries: entries.into_iter() })
+}
+
+/// Takes `names`'s node out of its directory when `check` allows it.
+fn take(names: &[OsString], check: impl FnOnce(&Node) -> io::Result<()>) -> io::Result<Node> {
+    let Some((last, parents)) = names.split_last() else {
+        return Err(fs_error!(PermissionDenied, "the root can't be removed"));
+    };
+    let mut root = write_root();
+    let dir = find_dir_mut(&mut root, parents)?;
+    check(dir.entries.get(last).ok_or(fs_error!(NotFound, "no such file or directory"))?)?;
+    dir.times.modified = SystemTime::now();
+    Ok(dir.entries.remove(last).unwrap())
+}
+
+pub fn unlink(p: &Path) -> io::Result<()> {
+    take(&names(p)?, |node| match node {
+        Node::File(_) => Ok(()),
+        Node::Dir(_) => Err(fs_error!(IsADirectory, "is a directory")),
+    })
+    .map(drop)
+}
+
+fn rename_with(old: &Path, new: &Path, replace: bool) -> io::Result<()> {
+    let (old, new) = (names(old)?, names(new)?);
+    if old == new {
+        return stat_names(&old).map(drop);
+    }
+    if new.starts_with(&old) {
+        return Err(fs_error!(InvalidInput, "can't move a directory into itself"));
+    }
+    let (Some((old_last, old_parents)), Some((new_last, new_parents))) =
+        (old.split_last(), new.split_last())
+    else {
+        return Err(fs_error!(InvalidInput, "can't rename the root"));
+    };
+    let mut root = write_root();
+    // Check both ends before changing anything.
+    let moving_dir = match find_dir(&root, old_parents)?.entries.get(old_last) {
+        Some(node) => matches!(node, Node::Dir(_)),
+        None => return Err(fs_error!(NotFound, "no such file or directory")),
+    };
+    match find_dir(&root, new_parents)?.entries.get(new_last) {
+        Some(_) if !replace => return Err(fs_error!(AlreadyExists, "file exists")),
+        Some(Node::Dir(_)) if !moving_dir => {
+            return Err(fs_error!(IsADirectory, "is a directory"));
+        }
+        Some(Node::Dir(d)) if !d.entries.is_empty() => {
+            return Err(fs_error!(DirectoryNotEmpty, "directory not empty"));
+        }
+        Some(Node::File(_)) if moving_dir => {
+            return Err(fs_error!(NotADirectory, "not a directory"));
+        }
+        _ => {}
+    }
+    let now = SystemTime::now();
+    let from = find_dir_mut(&mut root, old_parents)?;
+    let node = from.entries.remove(old_last).unwrap();
+    from.times.modified = now;
+    let to = find_dir_mut(&mut root, new_parents)?;
+    to.entries.insert(new_last.clone(), node);
+    to.times.modified = now;
+    Ok(())
+}
+
+pub fn rename(old: &Path, new: &Path) -> io::Result<()> {
+    rename_with(old, new, true)
+}
+
+pub fn rename_noreplace(old: &Path, new: &Path) -> io::Result<()> {
+    rename_with(old, new, false)
+}
+
+pub fn set_perm(p: &Path, perm: FilePermissions) -> io::Result<()> {
+    let names = names(p)?;
+    let root = read_root();
+    if let Node::File(node) = find(&root, &names)? {
+        node.readonly.store(perm.readonly, Ordering::Relaxed);
+    }
+    Ok(())
+}
+
+pub fn set_perm_nofollow(p: &Path, perm: FilePermissions) -> io::Result<()> {
+    set_perm(p, perm)
+}
+
+pub fn set_times(p: &Path, times: FileTimes) -> io::Result<()> {
+    let names = names(p)?;
+    let mut root = write_root();
+    let Some((last, parents)) = names.split_last() else {
+        return Ok(());
+    };
+    match find_dir_mut(&mut root, parents)?.entries.get_mut(last) {
+        Some(Node::File(node)) => {
+            let mut t = node.times.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(a) = times.accessed {
+                t.accessed = a;
+            }
+            if let Some(m) = times.modified {
+                t.modified = m;
+            }
+        }
+        Some(Node::Dir(dir)) => {
+            if let Some(a) = times.accessed {
+                dir.times.accessed = a;
+            }
+            if let Some(m) = times.modified {
+                dir.times.modified = m;
+            }
+        }
+        None => return Err(fs_error!(NotFound, "no such file or directory")),
+    }
+    Ok(())
+}
+
+pub fn set_times_nofollow(p: &Path, times: FileTimes) -> io::Result<()> {
+    set_times(p, times)
+}
+
+pub fn rmdir(p: &Path) -> io::Result<()> {
+    take(&names(p)?, |node| match node {
+        Node::Dir(d) if d.entries.is_empty() => Ok(()),
+        Node::Dir(_) => Err(fs_error!(DirectoryNotEmpty, "directory not empty")),
+        Node::File(_) => Err(fs_error!(NotADirectory, "not a directory")),
+    })
+    .map(drop)
+}
+
+pub fn remove_dir_all(path: &Path) -> io::Result<()> {
+    take(&names(path)?, |node| match node {
+        Node::Dir(_) => Ok(()),
+        Node::File(_) => Err(fs_error!(NotADirectory, "not a directory")),
+    })
+    .map(drop)
+}
+
+pub fn exists(path: &Path) -> io::Result<bool> {
+    match stat(path) {
+        Ok(_) => Ok(true),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(false),
+        Err(e) if e.kind() == io::ErrorKind::NotADirectory => Ok(false),
+        Err(e) => Err(e),
+    }
+}
+
+pub fn readlink(_p: &Path) -> io::Result<PathBuf> {
+    Err(fs_error!(InvalidInput, "not a symbolic link"))
+}
+
+pub fn symlink(_original: &Path, _link: &Path) -> io::Result<()> {
+    Err(fs_error!(Unsupported, "no symbolic links in the browser's filesystem"))
+}
+
+pub fn link(src: &Path, dst: &Path) -> io::Result<()> {
+    let (src, dst) = (names(src)?, names(dst)?);
+    let Some((last, parents)) = dst.split_last() else {
+        return Err(fs_error!(AlreadyExists, "the root exists"));
+    };
+    let mut root = write_root();
+    let node = match find(&root, &src)? {
+        Node::File(node) => node.clone(),
+        Node::Dir(_) => return Err(fs_error!(PermissionDenied, "can't hard-link a directory")),
+    };
+    let dir = find_dir_mut(&mut root, parents)?;
+    if dir.entries.contains_key(last) {
+        return Err(fs_error!(AlreadyExists, "file exists"));
+    }
+    dir.entries.insert(last.clone(), Node::File(node));
+    Ok(())
+}
+
+pub fn stat(p: &Path) -> io::Result<FileAttr> {
+    stat_names(&names(p)?)
+}
+
+pub fn lstat(p: &Path) -> io::Result<FileAttr> {
+    stat(p)
+}
+
+pub fn canonicalize(p: &Path) -> io::Result<PathBuf> {
+    let names = names(p)?;
+    stat_names(&names)?;
+    Ok(to_path(&names))
+}
+
+pub fn copy(from: &Path, to: &Path) -> io::Result<u64> {
+    let data = {
+        let names = names(from)?;
+        let root = read_root();
+        match find(&root, &names)? {
+            Node::File(node) => node.data.read().unwrap_or_else(|e| e.into_inner()).clone(),
+            Node::Dir(_) => return Err(fs_error!(InvalidInput, "the source is a directory")),
+        }
+    };
+    let mut opts = OpenOptions::new();
+    opts.write(true);
+    opts.create(true);
+    opts.truncate(true);
+    let file = File::open(to, &opts)?;
+    let len = data.len() as u64;
+    *file.node()?.data.write().unwrap_or_else(|e| e.into_inner()) = data;
+    Ok(len)
+}
